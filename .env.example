# Server-only database connection. Never expose this as NEXT_PUBLIC_*.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Managed Better Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Canonical Zeus AI provider. Keep both credentials server-only.
UNOROUTER_API_KEY_1=
UNOROUTER_API_KEY_2=
ZEUS_DEFAULT_MODEL=
# Declare only capabilities verified for the configured model, comma-separated.
# Example values: tools,structured_output,stream,usage,cancellation
ZEUS_UNOROUTER_CAPABILITIES=

# Optional model aliases. Runtime may fall back to ZEUS_DEFAULT_MODEL.
ZEUS_FAST_MODEL=
ZEUS_STRONG_MODEL=
ZEUS_CODING_MODEL=
ZEUS_MANAGER_MODEL=
ZEUS_DESIGN_MODEL=
ZEUS_TEST_MODEL=
ZEUS_SALES_MODEL=

# Retained optional provider adapter. UNOROUTER is canonical for Zeus.
OPENROUTER_API_KEY=

# M5 CredentialVault. Value is a base64-encoded 32-byte server-only key.
ZEUS_CREDENTIAL_KEY_VERSION=1
ZEUS_CREDENTIAL_KEY_V1=

# Optional deployment origins / protected automation trigger.
ZEUS_PUBLIC_ORIGIN=http://localhost:3000
ZEUS_APP_URL=http://localhost:3000
ZEUS_AUTOMATION_TRIGGER_SECRET=
